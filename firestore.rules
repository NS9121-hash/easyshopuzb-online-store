rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products can be read by anyone; writes restricted or open for bot/admin
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders can be created by customers, read and updated by matching order or admin
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Support messages can be read and written by matching userId
    match /support_messages/{messageId} {
      allow read, write: if true;
    }

    // Bot session states (temporary wizard data)
    match /bot_sessions/{sessionId} {
      allow read, write: if true;
    }
  }
}
