# Supabase Configuration
# Get these from your Supabase project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (for server-side operations)
# Keep this secret! Never expose in client-side code
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Telegram Bot Tokens
# Create bots with @BotFather on Telegram
ADMIN_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefgh
PAYMENT_BOT_TOKEN=987654321:XYZabcdefghijklmnopqrstuvwxyzABCDEF
ORDER_BOT_TOKEN=555666777:qwertyuiopasdfghjklzxcvbnmQWERTYUI

# Admin Configuration
# Your personal Telegram username (without @)
NEXT_PUBLIC_ADMIN_USERNAME=your_telegram_username

# Admin chat ID for receiving order notifications
# Get this from @userinfobot on Telegram
ADMIN_CHAT_ID=123456789

# Optional: Webhook URL (set after deployment)
# NEXT_PUBLIC_WEBHOOK_URL=https://your-vercel-domain.com
